{
  "name": "image-review-annotator",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "tsx src/server/server.ts",
    "dev:client": "node scripts/client.mjs",
    "build": "vite build && tsc -p tsconfig.server.json && node scripts/copy-migrations.mjs",
    "start": "node scripts/start.mjs",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json",
    "test": "vitest run --config tests/vitest.config.ts"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "express": "5.3.0",
    "pino": "10.4.0",
    "vue": "3.5.44",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/supertest": "7.2.1",
    "@vitejs/plugin-vue": "6.0.10",
    "eslint": "10.13.0",
    "eslint-plugin-vue": "10.11.1",
    "globals": "17.13.0",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "vue-tsc": "3.3.13"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "esbuild@0.28.2": true
  }
}
